        {
            "id": "references/namespace-qualified",
            "description": "after use package::types, types::User reaches the item",
            "packages": [
                {
                    "name": "app",
                    "config": "congregation app\nspecification_version = 1\n",
                    "schemas": [
                        {
                            "path": "src/types.ids",
                            "text": "struct User {\n    id: u32\n}\n\nstruct Order {\n    id: u32\n}\n"
                        },
                        {
                            "path": "src/api.ids",
                            "text": "use package::types\n\nstruct Account {\n    owner: types::User\n}\n"
                        }
                    ],
                    "dependencies": []
                }
            ],
            "build": "app",
            "expect": {
                "protocols": [],
                "builds": true,
                "diagnostics": []
            }
        },
